# Personal Knowledge Cloud Configuration

# ============================================
# Server Configuration
# ============================================
PKC_SERVER_IP=192.168.9.98

# Path to PKC installation (used by n8n workflows)
# Set this to the absolute path where PKC is installed
PKC_HOME=/home/user/pkc

# ============================================
# Service Ports
# ============================================
OPENWEBUI_PORT=31028
OLLAMA_PORT=30068
QDRANT_PORT=30333
N8N_PORT=30109

# ============================================
# Watch Folder Configuration
# ============================================
# Path to the folder to monitor for new files
WATCH_FOLDER_PATH=/mnt/user/pkc/watch
# Interval in seconds to check for new files
WATCH_FOLDER_INTERVAL=60
# Archive processed files instead of deleting
WATCH_FOLDER_ARCHIVE=true
# Archive folder path
WATCH_FOLDER_ARCHIVE_PATH=/mnt/user/pkc/archive

# ============================================
# Gmail Configuration
# ============================================
# Gmail OAuth2 Credentials
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# Gmail fetch settings
GMAIL_FETCH_INTERVAL=300
GMAIL_MAX_RESULTS=50
GMAIL_QUERY=is:unread label:pkc

# ============================================
# Qdrant Configuration
# ============================================
# Qdrant server URL
QDRANT_URL=http://192.168.9.98:30333
# Collection name for documents
QDRANT_COLLECTION_NAME=pkc_documents
# Vector size (must match embedding model)
QDRANT_VECTOR_SIZE=768
# Distance metric (Cosine, Euclidean, Dot)
QDRANT_DISTANCE_METRIC=Cosine

# ============================================
# Ollama Configuration
# ============================================
# Ollama server URL
OLLAMA_URL=http://192.168.9.98:30068
# Main LLM model for generation
OLLAMA_MODEL=llama2
# Embedding model for vector generation
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Model temperature for generation
OLLAMA_TEMPERATURE=0.7

# ============================================
# OpenWebUI Configuration
# ============================================
OPENWEBUI_URL=http://192.168.9.98:31028

# ============================================
# Processing Configuration
# ============================================
# Text chunk size for document splitting
CHUNK_SIZE=1000
# Chunk overlap for better context
CHUNK_OVERLAP=200
# Maximum file size in MB
MAX_FILE_SIZE_MB=50
# Supported file types (comma-separated)
SUPPORTED_FILE_TYPES=.pdf,.txt,.md,.docx,.doc,.html,.csv

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/pkc/pkc.log

# ============================================
# n8n Webhook Configuration
# ============================================
N8N_WEBHOOK_URL=http://192.168.9.98:30109/webhook
N8N_FILE_UPLOAD_WEBHOOK=upload-file
N8N_PROCESS_COMPLETE_WEBHOOK=process-complete
